#!/bin/sh
set -eu

branch="$(git rev-parse --abbrev-ref HEAD)"

if [ "$branch" != "main" ]; then
  echo "auto-sync: skipped push because current branch is $branch"
  exit 0
fi

echo "auto-sync: pushing main to origin"
git push origin main

echo "auto-sync: publishing main to gh-pages"
git push origin main:gh-pages
